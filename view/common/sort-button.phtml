<div class="browse-controls flex">
    <?php if (isset($searchOption)) { ?>
        <nav role="navigation">
            <label for="columbo-navigation-search">Search</label>
            <input type="text" id="columbo-search-<?php echo $tableContainerId ?>">
        </nav>
    <?php } ?>
    <form class="sorting" action="">
        <label for="sort-by-<?php echo $tableContainerId ?>"><?php echo $this->translate("Sort by")?></label>
        <select name="sort-by-<?php echo $tableContainerId ?>" id="sort-by-<?php echo $tableContainerId ?>">
            <?php foreach ($sortOptions as $sortOption) {
                echo "<option>" . $this->translate($sortOption) . "</option>";
            }?>
        </select>
        <select name="sort-order-<?php echo $tableContainerId ?>" id="sort-order-<?php echo $tableContainerId ?>">
            <option value="asc">
                <?php echo $this->translate("Ascending"); ?>
            </option>
            <option value="desc">
                <?php echo $this->translate("Descending"); ?>
            </option>
        </select>
        <button type="button" id="sort-button-<?php echo $tableContainerId ?>"><?php echo $this->translate('Sort'); ?></button>
    </form>
<script>
document.addEventListener("DOMContentLoaded", function() {
    // partially generated by AI

    const sortBySelect = document.getElementById("sort-by-<?php echo $tableContainerId ?>");
    const sortOrderSelect = document.getElementById("sort-order-<?php echo $tableContainerId ?>");
    const sortButton = document.getElementById("sort-button-<?php echo $tableContainerId ?>");
    const containerId = "<?php echo $tableContainerId ?>";
    const container = document.getElementById(containerId);

    const originalTable = container.querySelector("table").cloneNode(true);
    const searchField = document.getElementById("columbo-search-<?php echo $tableContainerId ?>");

    if (!sortBySelect || !sortOrderSelect || !container) return;

    function sortTable() {
        const selected = sortBySelect.value;
        const sortOrder = sortOrderSelect.value;

        const table = container.querySelector("table");
        if (!table) return;

        const tbody = table.querySelector("tbody");
        if (!tbody) return;

        const headers = Array.from(table.querySelectorAll("thead th"));
        const colIndex = headers.findIndex(
            th => th.textContent.trim().toLowerCase() === selected.trim().toLowerCase()
        );

        if (colIndex === -1) {
            console.warn("No matching column found for:", selected);
            return;
        }

        const rows = Array.from(tbody.querySelectorAll("tr"));

        const isNumeric = rows.every(row => {
            const text = row.children[colIndex]?.textContent.trim();
            return text === "" || !isNaN(parseFloat(text));
        });

        rows.sort((a, b) => {
            const aText = a.children[colIndex]?.textContent.trim() || "";
            const bText = b.children[colIndex]?.textContent.trim() || "";

            let comparison;
            if (isNumeric) {
                comparison = parseFloat(aText) - parseFloat(bText);
            } else {
                comparison = aText.localeCompare(bText);
            }

            return sortOrder === "asc" ? comparison : -comparison;
        });

        tbody.innerHTML = "";
        rows.forEach(row => tbody.appendChild(row));
    }

    <?php if (isset($searchOption)) { ?>
    function search() {
        const text = searchField.value;

        if (!originalTable) return;

        const originalTbody = originalTable.querySelector("tbody");
        if (!originalTbody) return;

        const headers = Array.from(originalTable.querySelectorAll("thead th"));
        const colIndex = headers.findIndex(
            th => th.textContent.trim().toLowerCase() === String("<?php echo $searchOption; ?>").trim().toLowerCase()
        );

        if (colIndex === -1) {
            console.warn("No matching column found for:", String("<?php echo $searchOption; ?>").trim().toLowerCase());
            return;
        }

        const originalRows = Array.from(originalTbody.querySelectorAll("tr"));
        var rows = Array();
        originalRows.forEach(row => {
            if (row.children[colIndex]?.textContent.trim().toLowerCase().includes(text.trim().toLowerCase())) {
                rows.push(row.cloneNode(true))
            }
        });

        const table = container.querySelector("table");
        if (!table) return;

        const tbody = table.querySelector("tbody");
        if (!tbody) return;

        tbody.innerHTML = "";
        rows.forEach(row => tbody.appendChild(row));
    }
    <?php } ?>

    // Listen to both dropdowns
    sortButton.addEventListener("click", sortTable);

    <?php if (isset($searchOption)) { ?>
    searchField.addEventListener("input", search);
    <?php } ?>

});
</script>
</div>