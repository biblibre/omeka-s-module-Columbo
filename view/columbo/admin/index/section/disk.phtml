<?php
/**
 * Directory / bucket sizes are slow: each one is fetched asynchronously by
 * columbo.js from the "admin/columbo/size" route (data-columbo-size).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var int $mediaSize
 * @var string $mediaSizeReadable
 * @var bool $hasBucket
 */
$sizes = [
    'assets' => [$this->translate('Total assets size'), $this->translate('Size of the files/asset directory.')],
    'files' => [$this->translate('Total ingested files'), $this->translate('Size of the files directory (original files, derivatives and assets).')],
];
if ($hasBucket) {
    $sizes['bucket'] = [$this->translate('Total remote ingested files'), $this->translate('Size of the remote storage (AnyCloud).')];
}
$sizes['omeka'] = [$this->translate('Total omeka install size'), $this->translate('Size of the whole Omeka S directory. May be inaccurate due to permissions.')];
?>
<?= $this->partial('common/columbo-block-header', [
    'id' => 'columbo-disk',
    'title' => $this->translate('Disk usage'),
]) ?>
<table class="tablesaw tablesaw-stack columbo-table" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th><?= $this->translate('Indicator') ?></th>
            <th><?= $this->translate('Size') ?></th>
            <th><?= $this->translate('Description') ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><?= $this->translate('Total media size') ?></td>
            <td data-sort-value="<?= (int) $mediaSize ?>"><?= $this->escapeHtml($mediaSizeReadable) ?></td>
            <td><?= $this->translate('Sum of the media sizes registered in the database.') ?></td>
        </tr>
        <?php foreach ($sizes as $target => [$label, $description]): ?>
        <tr>
            <td><?= $label ?></td>
            <td data-sort-value="-1"
                data-columbo-size="<?= $this->escapeHtmlAttr($this->url('admin/columbo/size', ['target' => $target])) ?>"
                aria-busy="true"
            ><span class="columbo-spinner" aria-hidden="true"></span> <?= $this->translate('Calculating…') ?></td>
            <td><?= $description ?></td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
</details>
