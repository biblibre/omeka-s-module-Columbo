<?php
/**
 * Directory / bucket sizes are slow: each one is fetched asynchronously by
 * columbo.js from the "admin/columbo/size" route (data-columbo-size).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var int $mediaSize
 * @var string $mediaSizeReadable
 * @var int $mediaWithoutSizeCount
 * @var array $storage
 * @var string[] $storageDirectories
 */
$supported = $storage['type'] !== 'unsupported';
$descriptions = [
    'original' => $this->translate('Original files of the media.'),
    'asset' => $this->translate('Assets (thumbnails of resources, logos and images of sites).'),
];
$pendingCell = function (string $attributes) {
    return sprintf(
        '<td class="columbo-bytes" data-sort-value="-1" %s aria-busy="true"><span class="columbo-spinner" aria-hidden="true"></span> %s</td>',
        $attributes,
        $this->translate('Calculating…')
    );
};
$sizeCell = function (string $target, bool $inTotal = false) use ($pendingCell) {
    return $pendingCell(sprintf(
        'data-columbo-size="%s"%s%s',
        $this->escapeHtmlAttr($this->url('admin/columbo/size', ['target' => $target])),
        $inTotal ? ' data-columbo-in-total' : '',
        $target === 'original' ? ' data-columbo-original' : ''
    ));
};
?>
<?= $this->partial('common/columbo-block-header', [
    'id' => 'columbo-disk',
    'title' => $this->translate('Disk usage'),
]) ?>
<p class="columbo-help">
    <?= $this->translate('File storage:') ?>
    <strong><?= $this->escapeHtml($storage['name']) ?></strong>
    <?php if ($storage['path']): ?>
    (<code><?= $this->escapeHtml($storage['path']) ?></code>)
    <?php endif; ?>
</p>
<?php if (!$supported): ?>
<p class="columbo-help"><?= $this->translate('The size of this file storage cannot be calculated.') ?></p>
<?php endif; ?>
<table class="tablesaw tablesaw-stack columbo-table" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th><?= $this->translate('Indicator') ?></th>
            <th><?= $this->translate('Size') ?></th>
            <th><?= $this->translate('Description') ?></th>
        </tr>
    </thead>
    <tbody>
        <?php if ($supported): ?>
        <?php foreach ($storageDirectories as $directory): ?>
        <tr>
            <td><code><?= $this->escapeHtml($directory) ?>/</code></td>
            <?= $sizeCell($directory, true) ?>
            <td><?= $descriptions[$directory] ?? sprintf($this->translate('Thumbnails "%s".'), $this->escapeHtml($directory)) ?></td>
        </tr>
        <?php endforeach; ?>
        <tr>
            <td><?= $this->translate('Total file storage') ?></td>
            <?= $pendingCell('data-columbo-total') ?>
            <td><?= $this->translate('Sum of the storage directories.') ?></td>
        </tr>
        <?php endif; ?>
        <tr>
            <td><?= $this->translate('Total original files size') ?></td>
            <td class="columbo-bytes" data-sort-value="<?= (int) $mediaSize ?>"><?= $this->escapeHtml($mediaSizeReadable) ?></td>
            <td><?= $this->translate('Sum of the original file sizes registered in the database at import, without thumbnails and assets. Should be close to the size of the original directory.') ?></td>
        </tr>
        <?php if ($supported): ?>
        <tr>
            <td><?= $this->translate('Difference between disk and database') ?></td>
            <?= $pendingCell(sprintf('data-columbo-diff="%d"', $mediaSize)) ?>
            <td>
                <?= $this->translate('Size of the original directory minus the size registered in the database. Positive: files not registered (orphan files) or media without registered size; negative: missing files.') ?>
                <?= sprintf($this->translate('Media without registered size: %d.'), $mediaWithoutSizeCount) ?>
            </td>
        </tr>
        <?php endif; ?>
        <tr>
            <td><?= $this->translate('Total omeka install size') ?></td>
            <?= $sizeCell('omeka') ?>
            <td><?= $this->translate('Size of the whole Omeka S directory. May be inaccurate due to permissions.') ?></td>
        </tr>
    </tbody>
</table>
</details>
